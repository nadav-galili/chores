DATABASE_URL=postgres://postgres:postgres@localhost:5499/chores
PORT=3000
CLERK_SECRET_KEY=sk_test_...
POSTHOG_API_KEY=phc_...
# Tags every server event as app_env; the dashboards count only production. Unset = development.
APP_ENV=development
REVENUECAT_WEBHOOK_SIGNING_SECRET=rcwhsec_...
# App Review sign-in (#100). Both or neither; unset, POST /review-access answers 404.
# REVIEW_EMAIL must equal REVIEW_EMAIL in packages/shared/src/review.ts, or the API will not start.
# The secret goes in App Store Connect's App Review Information, never in this repo.
REVIEW_EMAIL=review@mibokids.app
REVIEW_SECRET=
