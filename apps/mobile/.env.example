EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# The live API. A physical device is on your LAN, not on the emulator's loopback, so this is the
# only value that works everywhere — and it is the value the RevenueCat webhook writes into, so a
# device pointed anywhere else is a device the premium entitlement can never reach.
# Android emulator against a local server: http://10.0.2.2:3000
# iOS simulator against a local server:    http://localhost:3000
EXPO_PUBLIC_API_URL=https://api-production-c5c7.up.railway.app
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
